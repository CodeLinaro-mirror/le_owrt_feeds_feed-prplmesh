From f592464bc23f7988ae38924ceeff4647de228fa0 Mon Sep 17 00:00:00 2001
From: Ahmed Amine HAOUES <ahmed-amine.haoues_ext@softathome.com>
Date: Tue, 29 Sep 2026 15:35:51 +0200
Subject: [PATCH 27/41] rad: define new FTA handlers to stop and resume radio's
 fronthaul

New feature:
- define two new FTA handlers to stop and resume radio's fronthaul
activity (bss beaconing)
- these handlers aimed to be called when backhaul starts or stops
connecting

References: PPM-4222
Signed-off-by: Ahmed Amine HAOUES <ahmed-amine.haoues_ext@softathome.com>
Upstream-Status: Backport [https://gitlab.com/prpl-foundation/prplmesh/pwhm/plugins/pwhm/-/commit/dc20b1e7aea594334d8c0e7d5cbd5147746c5915]
---
 include/wld/wld.h       | 14 ++++++++++++++
 src/wld_functionTable.c | 10 ++++++++++
 2 files changed, 24 insertions(+)

diff --git a/include/wld/wld.h b/include/wld/wld.h
index ebe65663c6ccb6483977cc0fff9bd45e27e49a44..6a284abff56236086e40e82aa86f6bc959d90ba0 100644
--- a/include/wld/wld.h
+++ b/include/wld/wld.h
@@ -2906,6 +2906,20 @@ typedef struct S_CWLD_FUNC_TABLE {
     /** get stats counters of requested affiliated accesspoint BSS */
     swl_rc_ne (* mfn_wvap_getMloStats)(T_AccessPoint* vap, wld_mloStats_t* stats);
     PFN_WRAD_STARTPLATFORMACS mfn_wrad_startPltfACS; /**< Start platform ACS process! */
+
+    /**
+     * Stop the radio fronthaul activity (bss beaconing, scan).
+     * This allows backhaul connection to occur smoothly
+     * and it does not change the accessPoint's enabling configuration.
+     */
+    swl_rc_ne (* mfn_wrad_stopFronthaul)(T_Radio* rad);
+
+    /**
+     * Restore the radio fronthaul (bss beaconing).
+     * This handler does not change the accessPoint's enabling configuration.
+     */
+    swl_rc_ne (* mfn_wrad_restoreFronthaul)(T_Radio* rad);
+
 } T_CWLD_FUNC_TABLE;
 
 /**
diff --git a/src/wld_functionTable.c b/src/wld_functionTable.c
index ffddf4f7ce95e5d15270a959f65a334cae0cb19c..cefbba7e4807fce15229f5f19b29372dac1408d8 100644
--- a/src/wld_functionTable.c
+++ b/src/wld_functionTable.c
@@ -750,6 +750,14 @@ static swl_rc_ne TRAP_mfn_wrad_startPltfACS(T_Radio* rad _UNUSED, const amxc_var
     return SWL_RC_NOT_IMPLEMENTED;
 }
 
+static swl_rc_ne TRAP_mfn_wrad_stopFronthaul(T_Radio* rad _UNUSED) {
+    return SWL_RC_NOT_IMPLEMENTED;
+}
+
+static swl_rc_ne TRAP_mfn_wrad_restoreFronthaul(T_Radio* rad _UNUSED) {
+    return SWL_RC_NOT_IMPLEMENTED;
+}
+
 void wld_functionTable_init(vendor_t* vendor, T_CWLD_FUNC_TABLE* fta) {
 
 #define FTA_ASSIGN(x) \
@@ -827,6 +835,8 @@ void wld_functionTable_init(vendor_t* vendor, T_CWLD_FUNC_TABLE* fta) {
     FTA_ASSIGN(mfn_wrad_generateVapIfName);
     FTA_ASSIGN(mfn_wrad_generateEpIfName);
     FTA_ASSIGN(mfn_wrad_startPltfACS);
+    FTA_ASSIGN(mfn_wrad_stopFronthaul);
+    FTA_ASSIGN(mfn_wrad_restoreFronthaul);
 
     // wvap functions
     FTA_ASSIGN(mfn_wvap_create_hook);
