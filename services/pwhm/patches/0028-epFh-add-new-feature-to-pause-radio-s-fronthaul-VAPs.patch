+/**
+ * Managing BackHaul FrontHaul synchronization
+ */
+
+#include "wld.h"
+#include "wld_bStaMld.h"
+#include "wld_ssid.h"
+#include "wld_endpoint.h"
+#include "wld_radio.h"
+#include "wld_eventing.h"
+#include "wld_epFh.h"
+#include <debug/sahtrace.h>
+
+#define ME "epFh"
+
+/**
+ * @brief check whether radio and at least one of its vap is configured as enabled
+ * (using dm saved values ensures referring to user conf)
+ * @param pRad radio context
+ * @return bool true when radio is configured enabled and
+ *                   has at least one referencing vap configured enabled
+ *              false otherwise
+ */
+static bool s_hasCfgEnabledFronthaul(T_Radio* pRad) {
+    ASSERT_NOT_NULL(pRad, false, ME, "NULL");
+    if(!amxd_object_get_bool(pRad->pBus, "Enable", NULL)) {
+        return false;
+    }
+    T_AccessPoint* pAP = NULL;
+    wld_rad_forEachAp(pAP, pRad) {
+        if(pAP->pSSID &&
+           amxd_object_get_bool(pAP->pSSID->pBus, "Enable", NULL) &&
+           amxd_object_get_bool(pAP->pBus, "Enable", NULL)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/**
+ * @brief stop radio's fronthaul activity (beaconing, neighbor scan)
+ * if enabled and still active
+ *
+ * @param pRad radio context
+ *
+ * @return SWL_RC_OK on success, error code otherwise
+ */
+static swl_rc_ne s_stopFronthaul(T_Radio* pRad) {
+    ASSERT_NOT_NULL(pRad, SWL_RC_INVALID_PARAM, ME, "NULL");
+    if(wld_scan_isRunning(pRad)) {
+        wld_scan_stop(pRad);
+    }
+    ASSERTW_TRUE(s_hasCfgEnabledFronthaul(pRad), SWL_RC_INVALID_STATE, ME, "%s: radio fronthaul is already disabled", pRad->Name);
+    if(!(wld_rad_hasActiveVap(pRad) || (pRad->detailedState == CM_RAD_FG_CAC))) {
+        SAH_TRACEZ_WARNING(ME, "%s: radio fronthaul is not active", pRad->Name);
+        return SWL_RC_INVALID_STATE;
+    }
+    SAH_TRACEZ_INFO(ME, "%s: try to stop fronthaul", pRad->Name);
+    swl_rc_ne rc = pRad->pFA->mfn_wrad_stopFronthaul(pRad);
+    SAH_TRACEZ_INFO(ME, "%s: stop fronthaul retcode:%d", pRad->Name, rc);
+    if(rc == SWL_RC_OK) {
+        if(!pRad->fsmRad.timer) {
+            wld_rad_doCommitIfUnblocked(pRad);
+        }
+    }
+    return rc;
+}
+
+/**
+ * @brief restore radio's fronthaul activity (beaconing)
+ * if enabled and not yet active
+ *
+ * @param pRad radio context
+ *
+ * @return SWL_RC_OK on success, error code otherwise
+ */
+static swl_rc_ne s_restoreFronthaul(T_Radio* pRad) {
+    ASSERT_NOT_NULL(pRad, SWL_RC_INVALID_PARAM, ME, "NULL");
+    ASSERTW_TRUE(s_hasCfgEnabledFronthaul(pRad), SWL_RC_INVALID_STATE, ME, "%s: radio fronthaul is disabled", pRad->Name);
+    if(wld_rad_hasActiveVap(pRad) || (pRad->detailedState == CM_RAD_FG_CAC)) {
+        SAH_TRACEZ_WARNING(ME, "%s: radio fronthaul is already active", pRad->Name);
+        return SWL_RC_INVALID_STATE;
+    }
+    SAH_TRACEZ_INFO(ME, "%s: try to restore fronthaul", pRad->Name);
+    swl_rc_ne rc = pRad->pFA->mfn_wrad_restoreFronthaul(pRad);
+    SAH_TRACEZ_INFO(ME, "%s: restore fronthaul retcode:%d", pRad->Name, rc);
+    if(rc == SWL_RC_OK) {
+        if(!pRad->fsmRad.timer) {
+            wld_rad_doCommitIfUnblocked(pRad);
+        }
+    }
+    return rc;
+}
+
+/**
+ * @brief check radios's backhaul (ie EP) connection status and
+ * decide whether to restore radio's frontHaul (ie VAPs)
+ *
+ * @param pRad radio context
+ *
+ * @return void
+ */
+static void s_checkBhToRestoreFronthaul(T_Radio* pRad) {
+    ASSERT_NOT_NULL(pRad, , ME, "NULL");
+    wld_epConnectionStatus_e connState = EPCS_DISABLED;
+    T_EndPoint* pEP = wld_rad_getEnabledEndpoint(pRad);
+    if(pEP != NULL) {
+        connState = pEP->connectionStatus;
+    }
+    if((connState == EPCS_DISCOVERING) ||
+       (connState == EPCS_WPS_PAIRING) ||
+       (connState == EPCS_WPS_PAIRINGDONE) ||
+       (connState == EPCS_CONNECTING)) {
+        SAH_TRACEZ_INFO(ME, "%s: ongoing connection on backhaul (connSt:%s)",
+                        pRad->Name, cstr_EndPoint_connectionStatus[connState]);
+    } else {
+        SAH_TRACEZ_INFO(ME, "%s: no connection on backhaul (connSt:%s)",
+                        pRad->Name, cstr_EndPoint_connectionStatus[connState]);
+        s_restoreFronthaul(pRad);
+    }
+}
+
+/**
+ * @brief start timer to restore fronthaul (ie vaps) on given radio band
+ *
+ * @param pRad radio context
+ *
+ * @return void
+ */
+static void s_delayRestoreFronthaul(T_Radio* pRad) {
+    SAH_TRACEZ_INFO(ME, "%s: start delay to restore fronthaul", pRad->Name);
+    swla_delayExec_addTimeout((swla_delayExecFun_cbf) s_checkBhToRestoreFronthaul, pRad, FH_RESTORE_DELAY_MS);
+}
+
+/**
+ * @brief handler to process endpoint's connection status changes
+ * and decide whether to stop or restore relative radio's fronthaul
+ * @param event
+ * @return void
+ */
+static void s_epStateUpdateCb(wld_ep_status_change_event_t* event) {
+    ASSERT_NOT_NULL(event, , ME, "NULL");
+    T_EndPoint* pEP = event->ep;
+    ASSERT_NOT_NULL(pEP, , ME, "NULL");
+    T_Radio* pRad = pEP->pRadio;
+    ASSERT_NOT_NULL(pRad, , ME, "NULL");
+
+    if(pEP->connectionStatus == event->oldConnectionStatus) {
+        SAH_TRACEZ_INFO(ME, "%s: same connection status (%s)", pEP->alias, cstr_EndPoint_connectionStatus[event->oldConnectionStatus]);
+        return;
+    }
+    SAH_TRACEZ_INFO(ME, "%s: connection status changed (%s) -> (%s)",
+                    pEP->alias, cstr_EndPoint_connectionStatus[event->oldConnectionStatus], cstr_EndPoint_connectionStatus[pEP->connectionStatus]);
+
+    if((pEP->connectionStatus == EPCS_DISCOVERING) ||
+       (pEP->connectionStatus == EPCS_WPS_PAIRING) ||
+       ((pEP->connectionStatus == EPCS_CONNECTING) &&
+        ((event->oldConnectionStatus != EPCS_DISCOVERING) &&
+         (event->oldConnectionStatus != EPCS_WPS_PAIRING)))) {
+        /**
+         * stop fronthaul, when feature is enabled, whenever:
+         * 1) ep is scanning to connect through provisioned profile, or through wps
+         * 2) ep is connecting (sending AuthReq) (eg case when intermediate state is missing)
+         *    while previously not scanning
+         */
+        if(pEP->toggleBssOnReconnect) {
+            s_stopFronthaul(pRad);
+        }
+    } else if((pEP->connectionStatus == EPCS_CONNECTED) ||
+              ((event->oldConnectionStatus == EPCS_DISCOVERING) ||
+               (event->oldConnectionStatus == EPCS_WPS_PAIRING) ||
+               (event->oldConnectionStatus == EPCS_CONNECTING))) {
+        /**
+         * restore fronthaul, with some delay, whenever:
+         * 1) ep is connected
+         * 2) ep is not connected (disabled, disconnected, misconfigured, failing to scan, failing to connect)
+         *    while previously scanning/connecting
+         */
+        s_delayRestoreFronthaul(pRad);
+    }
+}
+
+static wld_event_callback_t s_epStateUpdateCbContainer = {
+    .callback = (wld_event_callback_fun) s_epStateUpdateCb
+};
+
+void wld_epFh_init(T_EndPoint* pEP) {
+    ASSERTS_NOT_NULL(pEP, , ME, "NULL");
+    pEP->toggleBssOnReconnect = false;
+    pEP->restoreBssDelay = FH_RESTORE_DELAY_MS;
+    wld_event_add_callback(gWld_queue_ep_onStatusChange, &s_epStateUpdateCbContainer);
+}
+
+void wld_epFh_cleanup(T_EndPoint* pEP) {
+    ASSERTS_NOT_NULL(pEP, , ME, "NULL");
+    wld_event_remove_callback(gWld_queue_ep_onStatusChange, &s_epStateUpdateCbContainer);
+}
+
