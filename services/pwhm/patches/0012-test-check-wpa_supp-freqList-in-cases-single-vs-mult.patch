From 65af3619c83c18d1d6318538c9b4fd4be784f496 Mon Sep 17 00:00:00 2001
From: Ahmed Amine HAOUES <ahmed-amine.haoues_ext@softathome.com>
Date: Mon, 18 May 2026 13:26:11 +0200
Subject: [PATCH 12/41] test: check wpa_supp freqList in cases single vs multi
 wiphy devices

New test:
- check freq_list param filling with:
- 1) own radio band frequencies in case of multi wiphy device
- 2) all radio bands frequencies in case of single wiphy device

References: PPM-4222
Signed-off-by: Ahmed Amine HAOUES <ahmed-amine.haoues_ext@softathome.com>
Upstream-Status: Backport [https://gitlab.com/prpl-foundation/prplmesh/pwhm/plugins/pwhm/-/commit/297353487e9262a2354ed7c6d3247cfbede21c40]
---
 .../test_wpaSupp_cfgFile.c                    | 74 +++++++++++++++++++
 1 file changed, 74 insertions(+)

diff --git a/test/test_wpaSupp_cfgFile/test_wpaSupp_cfgFile.c b/test/test_wpaSupp_cfgFile/test_wpaSupp_cfgFile.c
index 6443fa8b9f19dfe3c7ddbd58c333dd02eb17a956..74ee96c2f6bfe2d66d346bab2fefba4440ac1a68 100644
--- a/test/test_wpaSupp_cfgFile/test_wpaSupp_cfgFile.c
+++ b/test/test_wpaSupp_cfgFile/test_wpaSupp_cfgFile.c
@@ -180,6 +180,79 @@ static void test_6g_freq_list_when_OnlyScanPscChannels_enabled(void** state _UNU
     s_build_read_freqList(dm.bandList[SWL_FREQ_BAND_6GHZ].ep);
 }
 
+static int s_set_multi_wiphy(void** state _UNUSED) {
+    for(size_t i = 0; i < SWL_FREQ_BAND_MAX; i++) {
+        wld_th_dmBand_t* band = &dm.bandList[i];
+        T_Radio* pRad = band->rad;
+        ttb_assert_non_null(pRad);
+        snprintf(pRad->wiphyName, sizeof(pRad->wiphyName), "phy%zu", i);
+        pRad->wiphy = i;
+    }
+    return 0;
+}
+
+static int s_set_single_wiphy(void** state _UNUSED) {
+    for(size_t i = 0; i < SWL_FREQ_BAND_MAX; i++) {
+        wld_th_dmBand_t* band = &dm.bandList[i];
+        T_Radio* pRad = band->rad;
+        ttb_assert_non_null(pRad);
+        swl_str_copy(pRad->wiphyName, sizeof(pRad->wiphyName), "phy00");
+        pRad->wiphy = 0;
+    }
+    return 0;
+}
+
+static void test_read_freqList_multi_vs_single_wiphy(void** state _UNUSED) {
+    wld_th_dmBand_t* band = &dm.bandList[SWL_FREQ_BAND_6GHZ];
+    T_Radio* pRad = band->rad;
+    T_EndPoint* pEP = band->ep;
+    char freqListStr[WLD_L_BUF] = {0};
+    char expectedFreqList[WLD_L_BUF] = {0};
+    swl_rc_ne rc;
+    swl_freqBand_m expectedFreqBands = 0;
+    swl_freqBand_m freqBands = 0;
+
+
+    /** initial freq list: rad6g has its own wiphy device => 6g freq list */
+    s_set_multi_wiphy(state);
+    expectedFreqBands = (swl_freqBand_m) SWL_BIT_SHIFT(pRad->operatingFrequencyBand);
+    pRad->scanState.cfg.onlyScanPscChannels = 1;
+    rc = wld_rad_printPossibleFreqsWithSep(pRad, expectedFreqList, sizeof(expectedFreqList), " ", pRad->scanState.cfg.onlyScanPscChannels, true);
+    ttb_assert_int_eq(SWL_RC_OK, rc);
+    wld_wpaSupp_cfgFile_readFreqList(pEP, freqListStr, sizeof(freqListStr));
+    ttb_assert_str_eq(freqListStr, expectedFreqList);
+    wld_wpaSupp_cfgFile_readFreqBands(pEP, &freqBands);
+    ttb_assert_int_eq(freqBands, expectedFreqBands);
+
+    /** reset saved freq_list and set single wiphy, then check all bands freq_list */
+    wld_wpaSupp_cfgFile_globalConfigUpdate(pEP->wpaSupp->cfgFile, "freq_list", "");
+    s_set_single_wiphy(state);
+    for(size_t i = 0; i < SWL_FREQ_BAND_MAX; i++) {
+        wld_th_dmBand_t* tmpBand = &dm.bandList[i];
+        if(tmpBand == band) {
+            continue;
+        }
+        wld_rad_printPossibleFreqsWithSep(tmpBand->rad, expectedFreqList, sizeof(expectedFreqList), " ", tmpBand->rad->scanState.cfg.onlyScanPscChannels, false);
+        expectedFreqBands |= (swl_freqBand_m) SWL_BIT_SHIFT(tmpBand->rad->operatingFrequencyBand);
+    }
+    freqListStr[0] = 0;
+    wld_wpaSupp_cfgFile_readFreqList(pEP, freqListStr, sizeof(freqListStr));
+    ttb_assert_str_eq(freqListStr, expectedFreqList);
+    wld_wpaSupp_cfgFile_readFreqBands(pEP, &freqBands);
+    ttb_assert_int_eq(freqBands, expectedFreqBands);
+
+    /** reset saved freq_list and set multi wiphy, then check single band freq_list */
+    wld_wpaSupp_cfgFile_globalConfigUpdate(pEP->wpaSupp->cfgFile, "freq_list", "");
+    s_set_multi_wiphy(state);
+    expectedFreqBands = (swl_freqBand_m) SWL_BIT_SHIFT(pRad->operatingFrequencyBand);
+    wld_rad_printPossibleFreqsWithSep(pRad, expectedFreqList, sizeof(expectedFreqList), " ", pRad->scanState.cfg.onlyScanPscChannels, true);
+    freqListStr[0] = 0;
+    wld_wpaSupp_cfgFile_readFreqList(pEP, freqListStr, sizeof(freqListStr));
+    ttb_assert_str_eq(freqListStr, expectedFreqList);
+    wld_wpaSupp_cfgFile_readFreqBands(pEP, &freqBands);
+    ttb_assert_int_eq(freqBands, expectedFreqBands);
+}
+
 int main(int argc _UNUSED, char* argv[] _UNUSED) {
     sahTraceSetLevel(TRACE_LEVEL_INFO);
     sahTraceAddZone(sahTraceLevel(), "rad");
@@ -191,6 +264,7 @@ int main(int argc _UNUSED, char* argv[] _UNUSED) {
         cmocka_unit_test(test_build_read_freqList_5g),
         cmocka_unit_test(test_6g_freq_list_when_OnlyScanPscChannels_disabled),
         cmocka_unit_test(test_6g_freq_list_when_OnlyScanPscChannels_enabled),
+        cmocka_unit_test_setup_teardown(test_read_freqList_multi_vs_single_wiphy, NULL, s_set_multi_wiphy),
     };
     return cmocka_run_group_tests(tests, setup_suite, teardown_suite);
 }
