         } else if((connInfo.connState == EPCS_CONNECTING) && (connInfo.chSpec.channel > 0)) {
@@ -1466,8 +1504,9 @@ swl_rc_ne wifiGen_refreshEpConnStatus(T_EndPoint* pEP) {
