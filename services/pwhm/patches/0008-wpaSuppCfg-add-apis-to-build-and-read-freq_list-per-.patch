Date: Mon, 18 May 2026 09:08:37 +0200
Subject: [PATCH 08/41] wpaSuppCfg: add apis to build and read freq_list per EP

New apis:
- add api to build scan FreqList of EP based on its radio freqList, and its
membership to bstamld
- add api to read scan FreqList of EP, from saved conf, or deduced on
wiphy device supported frequencies

References: PPM-4222
Signed-off-by: Ahmed Amine HAOUES <ahmed-amine.haoues_ext@softathome.com>
Upstream-Status: Backport [https://gitlab.com/prpl-foundation/prplmesh/pwhm/plugins/pwhm/-/commit/ef44b1d695104641d27b15ef58e14be69f40a218]
---
 include/wld/wld_wpaSupp_cfgFile.h |  33 ++++++++++
 src/nl80211/wld_wpaSupp_cfgFile.c | 106 ++++++++++++++++++++++++++----
 2 files changed, 128 insertions(+), 11 deletions(-)

diff --git a/include/wld/wld_wpaSupp_cfgFile.h b/include/wld/wld_wpaSupp_cfgFile.h
index d6cff0a022302c72e2e69c48ee8ebdcefaebdd95..070669ac703b82c7cbfdcd7c7facddfff10697dd 100644
--- a/include/wld/wld_wpaSupp_cfgFile.h
+++ b/include/wld/wld_wpaSupp_cfgFile.h
@@ -70,4 +70,37 @@ swl_rc_ne wld_wpaSupp_cfgFile_createExt(T_EndPoint* pEP);
 swl_rc_ne wld_wpaSupp_cfgFile_globalConfigUpdate(char* configPath, const char* key, const char* value);
 swl_rc_ne wld_wpaSupp_cfgFile_networkConfigUpdate(char* configPath, const char* key, const char* value);
 
+/**
+ * @brief build frequencies list to be scanned by wpa_supplicant
+ *
+ * @param [in,out] freqListStr output buffer, filled with space separated string list
+ * @param [in] freqListStrBufSize output buffer size
+ * @param [in] sep separator character
+ *
+ * @return SWL_RC_OK if successful, error code otherwise
+ */
+swl_rc_ne wld_wpaSupp_cfgFile_buildFreqList(T_EndPoint* pEP, char* freqListStr, size_t freqListStrBufSize);
+
+/**
+ * @brief read saved frequencies list , in param "freq_list" scanned by wpa_supplicant
+ * or assume, when param is empty, all frequencies handled by the wiphy device
+ *
+ * @param [in,out] freqListStr output buffer, filled with space separated string list
+ * @param [in] freqListStrBufSize output buffer size
+ *
+ * @return SWL_RC_OK if successful, error code otherwise
+ */
+swl_rc_ne wld_wpaSupp_cfgFile_readFreqList(T_EndPoint* pEP, char* freqListStr, size_t freqListStrBufSize);
+
+/**
+ * @brief read saved scan frequencies bands, from frequencies list,
+ * in wpa_supplicant param "freq_list"
+ * or assume, when param is empty, all frequencies handled by the wiphy device
+ *
+ * @param [in,out] pFreqBands output bitmap of scan frequency bands
+ *
+ * @return SWL_RC_OK if successful, error code otherwise
+ */
+swl_rc_ne wld_wpaSupp_cfgFile_readFreqBands(T_EndPoint* pEP, swl_freqBand_m* pFreqBands);
+
 #endif /* __WLD_WPA_SUPPLICANT_CFG_FILE_H__ */
diff --git a/src/nl80211/wld_wpaSupp_cfgFile.c b/src/nl80211/wld_wpaSupp_cfgFile.c
index b200181ed73e91ec75ad499f86b523d7b85cb472..94d4393192dacddc05ac40022cfdda161a407deb 100644
--- a/src/nl80211/wld_wpaSupp_cfgFile.c
+++ b/src/nl80211/wld_wpaSupp_cfgFile.c
@@ -78,20 +78,28 @@ static const char* wld_wpsConfigMethods[] = { "usba", "ethernet", "label", "disp
     "physical_push_button", "PIN",
     0};
 
-static void s_addMLOFreqCandidates(T_EndPoint* pEP, char* freqListStr, size_t freqListStrBufSize, const char* sep) {
-    ASSERTS_NOT_NULL(pEP, , ME, "NULL");
-    ASSERTS_NOT_NULL(freqListStr, , ME, "NULL");
-    ASSERTS_NOT_EQUALS(freqListStrBufSize, 0, , ME, "Invalid length");
-
+/**
+ * @brief build frequencies list to be scanned by wpa_supplicant
+ *
+ * @param [in,out] freqListStr output buffer to be filled
+ * @param [in] freqListStrBufSize output buffer size
+ * @param [in] sep separator character
+ *
+ * @return SWL_RC_OK if successful, error code otherwise
+ */
+static swl_rc_ne s_buildFreqList(T_EndPoint* pEP, char* freqListStr, size_t freqListStrBufSize, const char* sep) {
+    ASSERTS_NOT_NULL(pEP, SWL_RC_INVALID_PARAM, ME, "NULL");
+    ASSERTS_TRUE(freqListStr && freqListStrBufSize, SWL_RC_INVALID_PARAM, ME, "null target buffer");
     T_Radio* pRad = pEP->pRadio;
-    ASSERTS_NOT_NULL(pRad, , ME, "NULL");
+    ASSERT_NOT_NULL(pRad, SWL_RC_INVALID_STATE, ME, "%s: No mapped radio", pEP->alias);
+    T_SSID* pSSID = pEP->pSSID;
+    ASSERT_NOT_NULL(pSSID, SWL_RC_INVALID_STATE, ME, "%s: No mapped ssid", pEP->alias);
+
     bool onlyPscChannels = pRad->scanState.cfg.onlyScanPscChannels;
     wld_rad_printPossibleFreqsWithSep(pRad, freqListStr, freqListStrBufSize, sep, onlyPscChannels, false);
 
-    T_SSID* pSSID = pEP->pSSID;
-    ASSERTS_NOT_NULL(pSSID, , ME, "NULL");
-    ASSERTS_TRUE(wld_mld_isLinkUsable(pSSID->pMldLink), , ME, "Invalid link");
-
+    /** append frequencies of neighbor link's radios */
+    ASSERTI_TRUE(wld_mld_isLinkUsable(pSSID->pMldLink), SWL_RC_OK, ME, "%s: no usable link", pEP->alias);
     wld_mldLink_t* pLink = pSSID->pMldLink;
     wld_for_eachNeighMldLink_safe(pNgLink, pLink) {
         if(pLink == pNgLink) {
@@ -105,6 +113,82 @@ static void s_addMLOFreqCandidates(T_EndPoint* pEP, char* freqListStr, size_t fr
         onlyPscChannels = pNgRad->scanState.cfg.onlyScanPscChannels;
         wld_rad_printPossibleFreqsWithSep(pNgRad, freqListStr, freqListStrBufSize, sep, onlyPscChannels, false);
     }
