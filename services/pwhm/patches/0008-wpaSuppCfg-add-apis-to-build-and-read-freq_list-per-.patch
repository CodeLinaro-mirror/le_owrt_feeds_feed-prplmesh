+}
+
+swl_rc_ne wld_wpaSupp_cfgFile_buildFreqList(T_EndPoint* pEP, char* freqListStr, size_t freqListStrBufSize) {
+    return s_buildFreqList(pEP, freqListStr, freqListStrBufSize, " ");
+}
+
+/**
+ * @brief read saved frequencies list , in param "freq_list" scanned by wpa_supplicant
+ * or assume, when param is empty, all frequencies handled by the wiphy device
+ *
+ * @param [in,out] freqListStr output buffer to be filled
+ * @param [in] freqListStrBufSize output buffer size
+ * @param [in] sep separator character
+ *
+ * @return SWL_RC_OK if successful, error code otherwise
+ */
+static swl_rc_ne s_readFreqList(T_EndPoint* pEP, char* freqListStr, size_t freqListStrBufSize, const char* sep) {
+    ASSERTS_NOT_NULL(pEP, SWL_RC_INVALID_PARAM, ME, "NULL");
+    ASSERTS_TRUE(freqListStr && freqListStrBufSize, SWL_RC_INVALID_PARAM, ME, "null target buffer");
+    ASSERT_NOT_NULL(pEP->pRadio, SWL_RC_INVALID_STATE, ME, "%s: No mapped radio", pEP->alias);
+
+    /** try first to load saved freqlist */
+    wld_wpaSupp_config_t* conf = NULL;
+    if(pEP->wpaSupp && wld_wpaSupp_loadConfig(&conf, pEP->wpaSupp->cfgFile)) {
+        bool hasSavedFreqList = false;
+        char* savedFreqList = swl_mapChar_get(wld_wpaSupp_getGlobalConfig(conf), "freq_list");
+        if(!swl_str_isEmpty(savedFreqList)) {
+            swl_str_copy(freqListStr, freqListStrBufSize, savedFreqList);
+            hasSavedFreqList = true;
+        }
+        wld_wpaSupp_deleteConfig(conf);
+        if(hasSavedFreqList) {
+            return SWL_RC_OK;
+        }
+    }
+
+    /** otherwise assume all frequencies handled by the wiphy device */
+    bool onlyPscChannels = pEP->pRadio->scanState.cfg.onlyScanPscChannels;
+    wld_rad_printPossibleFreqsWithSep(pEP->pRadio, freqListStr, freqListStrBufSize, sep, onlyPscChannels, true);
+    T_Radio* pRad;
+    wld_for_eachRad(pRad) {
+        if(pRad == pEP->pRadio) {
+            continue;
+        }
+        if(swl_str_isEmpty(pRad->wiphyName) || !swl_str_matches(pRad->wiphyName, pEP->pRadio->wiphyName)) {
+            continue;
+        }
+        onlyPscChannels = pRad->scanState.cfg.onlyScanPscChannels;
+        wld_rad_printPossibleFreqsWithSep(pRad, freqListStr, freqListStrBufSize, sep, onlyPscChannels, false);
+    }
+    return SWL_RC_OK;
+}
+
+swl_rc_ne wld_wpaSupp_cfgFile_readFreqList(T_EndPoint* pEP, char* freqListStr, size_t freqListStrBufSize) {
+    return s_readFreqList(pEP, freqListStr, freqListStrBufSize, " ");
+}
+
+swl_rc_ne wld_wpaSupp_cfgFile_readFreqBands(T_EndPoint* pEP, swl_freqBand_m* pFreqBands) {
+    W_SWL_SETPTR(pFreqBands, 0);
+    swl_freqBand_m freqBands = 0;
+    char freqListStr[WLD_L_BUF] = {0};
+    swl_rc_ne rc = s_readFreqList(pEP, freqListStr, sizeof(freqListStr), " ");
+    ASSERTS_TRUE(swl_rc_isOk(rc), rc, ME, "fail to get freqList");
+
+    uint32_t nrFreqs = (swl_str_len(freqListStr) > 0) + swl_str_countChar(freqListStr, ' ');
+    uint32_t freqs[nrFreqs + 1];
+    nrFreqs = swl_typeUInt32_arrayFromCharSep(freqs, SWL_ARRAY_SIZE(freqs), freqListStr, " ");
+    for(uint32_t i = 0; i < nrFreqs; i++) {
+        swl_chanspec_t chSpec = SWL_CHANSPEC_EMPTY;
+        if((swl_chanspec_fromMHz(&chSpec, freqs[i]) >= SWL_RC_OK) && (chSpec.band < SWL_FREQ_BAND_EXT_NONE)) {
+            W_SWL_BIT_SET(freqBands, chSpec.band);
+        }
+    }
+    W_SWL_SETPTR(pFreqBands, freqBands);
+    return SWL_RC_OK;
 }
 
 /**
@@ -157,7 +241,7 @@ static swl_rc_ne s_setWpaSuppGlobalConfig(T_EndPoint* pEP, wld_wpaSupp_config_t*
     }
 
     char freqListStr[1024] = {'\0'};
-    s_addMLOFreqCandidates(pEP, freqListStr, sizeof(freqListStr), " ");
+    s_buildFreqList(pEP, freqListStr, sizeof(freqListStr), " ");
     if(!swl_str_isEmpty(freqListStr)) {
         swl_mapChar_add(global, "freq_list", freqListStr);
     }
