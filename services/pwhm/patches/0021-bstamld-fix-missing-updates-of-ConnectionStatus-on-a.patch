+/**
+ * @brief radio event handler of endpoint starting to connect (sending AUTH_REQ)
+ *
+ * @param [in] userData private data (registered with radio context)
+ * @param [in] ifName wpactrl interface name sourcing the event
+ * @param [in] ssid the remote SSID to which endpoint is connection
+ * @param [in] chanSpec the channel used to send the authentication request
+ *
+ * @return void
+ */
 static void s_syncOnEpStartConn(void* userData, char* ifName, const char* ssid, swl_macBin_t* bssid, swl_chanspec_t* chanSpec) {
     T_Radio* pRad = (T_Radio*) userData;
     T_EndPoint* pEP = wld_endpoint_fetchEpByChanInfo(wld_rad_ep_from_name(pRad, ifName), chanSpec);
     ASSERT_NOT_NULL(pEP, , ME, "NULL");
     SAH_TRACEZ_INFO(ME, "%s: endpoint is connecting to (%s) %s over chspec(%s)",
                     pEP->Name, ssid, swl_typeMacBin_toBuf32Ref(bssid).buf, swl_typeChanspecExt_toBuf32Ref(chanSpec).buf);
+
+    T_SSID* pSSID = pEP->pSSID;
+    if(wld_ssid_hasValidMLDRole(pSSID)) {
+        wld_for_eachNeighMldLink_safe(pNgLink, pSSID->pMldLink) {
+            T_SSID* pNgSSID = wld_mld_getLinkSsid(pNgLink);
+            if(!pNgSSID || !pNgSSID->ENDP_HOOK || (pNgSSID == pSSID) ||
+               !wld_ssid_hasValidMLDRole(pNgSSID)) {
+                continue;
+            }
+            T_EndPoint* pNgEp = pNgSSID->ENDP_HOOK;
+            if(pNgEp->connectionStatus == EPCS_DISCOVERING) {
+                // Set ConnectionStatus of all unlinked neighbor endpoints to idle
+                SAH_TRACEZ_INFO(ME, "neighbor endpoint %s is set to passive until full %s connection",
+                                pNgEp->Name, pEP->Name);
+                wld_endpoint_setConnectionStatus(pNgEp, EPCS_PASSIVE, EPE_NONE);
+            }
+        }
+    }
     ASSERTS_TRUE(wifiGen_hapd_isAlive(pRad), , ME, "%s: hapd not running", pRad->Name);
 
     swl_chanspec_t currChanSpec = SWL_CHANSPEC_EMPTY;
@@ -1940,6 +1971,42 @@ static void s_syncOnEpStartConn(void* userData, char* ifName, const char* ssid,
     }
 }
 
+/**
+ * @brief radio event handler of endpoint starting to scan
+ *
+ * @param [in] userData private data (registered with radio context)
+ * @param [in] ifName wpactrl interface name sourcing the event
+ *
+ * @return void
+ */
+static void s_syncOnEpScanStarted(void* userData, char* ifName) {
+    T_Radio* pRad = (T_Radio*) userData;
+    T_EndPoint* pEP = wld_rad_ep_from_name(pRad, ifName);
+    ASSERT_NOT_NULL(pEP, , ME, "NULL");
+    SAH_TRACEZ_INFO(ME, "%s: EP start scan (conSt:%d)", pEP->Name, pEP->connectionStatus);
+    if((pEP->connectionStatus != EPCS_DISCOVERING) &&
+       (pEP->connectionStatus != EPCS_WPS_PAIRING)) {
+        return;
+    }
+
+    T_SSID* pSSID = pEP->pSSID;
+    ASSERT_NOT_NULL(pSSID, , ME, "%s: No mapped ssid", pEP->Name);
+    /**
+     * distribute scan event to bSTAMLD auxiliary links
+     * (as the event is only sent to the primary link socket)
+     */
+    if(pSSID->mldRole == SWL_MLO_ROLE_PRIMARY) {
+        wld_for_eachNeighMldLink_safe(pNgLink, pSSID->pMldLink) {
+            T_SSID* pNgSSID = wld_mld_getLinkSsid(pNgLink);
+            if(pNgSSID && (pNgSSID->mldRole == SWL_MLO_ROLE_AUXILIARY) &&
+               pNgSSID->ENDP_HOOK &&
+               !wld_wpaCtrlInterface_isReady(pNgSSID->ENDP_HOOK->wpaCtrlInterface)) {
+                NOTIFY_NA_EXT(pNgSSID->ENDP_HOOK->wpaCtrlInterface, fStationScanStartedCb);
+            }
+        }
+    }
+}
+
