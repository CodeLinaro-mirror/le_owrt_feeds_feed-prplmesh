     T_Radio* pRad = (T_Radio*) userData;
     T_EndPoint* pEP = wld_rad_ep_from_name(pRad, ifName);
@@ -1951,11 +2018,11 @@ static void s_syncOnEpScanFail(void* userData, char* ifName, int error) {
