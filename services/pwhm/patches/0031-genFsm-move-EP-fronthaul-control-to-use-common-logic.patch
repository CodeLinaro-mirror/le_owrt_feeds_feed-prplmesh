 }
+
+swl_rc_ne wifiGen_rad_stopFronthaul(T_Radio* pRad) {
+    ASSERT_NOT_NULL(pRad, SWL_RC_INVALID_PARAM, ME, "NULL");
+    if(wld_scan_isRunning(pRad)) {
+        wld_scan_stop(pRad);
+    }
+    ASSERTS_TRUE(wifiGen_hapd_isAlive(pRad), SWL_RC_INVALID_STATE, ME, "%s: hapd not running", pRad->Name);
+    if(wifiGen_hapd_checkActive(pRad)) {
+        // disable BSSs to allow wpa_supplicant to do scan
+        SAH_TRACEZ_INFO(ME, "%s: disable hostapd ifaces to let wpa_supplicant take the control", pRad->Name);
+        setBitLongArray(pRad->fsmRad.FSM_BitActionArray, FSM_BW, GEN_FSM_DISABLE_HOSTAPD);
+        wld_rad_doCommitIfUnblocked(pRad);
+        return SWL_RC_OK;
+    }
+    return SWL_RC_DONE;
+}
+
+swl_rc_ne wifiGen_rad_restoreFronthaul(T_Radio* pRad) {
+    ASSERT_NOT_NULL(pRad, SWL_RC_INVALID_PARAM, ME, "NULL");
+    ASSERTS_TRUE(wifiGen_hapd_isAlive(pRad), SWL_RC_INVALID_STATE, ME, "%s: hapd not running", pRad->Name);
+    if(wifiGen_hapd_checkDown(pRad)) {
+        SAH_TRACEZ_INFO(ME, "%s: restore fronthaul chanspec conf", pRad->Name);
+        return pRad->pFA->mfn_wrad_setChanspec(pRad, true);
+    }
+    return SWL_RC_DONE;
+}
