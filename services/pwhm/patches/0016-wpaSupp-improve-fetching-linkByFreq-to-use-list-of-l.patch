+    int32_t pos = s_getMloLinkStatusDetailsByFreqBand(nbLinks, ppLinksDetails, band, linkStatus, linkStatusSize);
+    rc = (pos >= 0) ? SWL_RC_OK : SWL_RC_NOT_FOUND;
