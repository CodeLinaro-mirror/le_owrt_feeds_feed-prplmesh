+    char** ppLinksDetails = NULL;
+    swl_rc_ne rc = wld_wpaSupp_fetchMloLinkStatusDetails(mloStatusInfo, &nbLinks, &ppLinksDetails);
+    ASSERTS_TRUE(swl_rc_isOk(rc), rc, ME, "no links info");
 
-    char* pSep = NULL;
-    char* pMsg = (char*) mloStatusInfo;
-    while(pMsg[0]) {
