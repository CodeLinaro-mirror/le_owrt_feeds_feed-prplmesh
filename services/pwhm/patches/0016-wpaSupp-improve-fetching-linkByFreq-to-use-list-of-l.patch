From: Ahmed Amine HAOUES <ahmed-amine.haoues_ext@softathome.com>
Date: Tue, 19 May 2026 11:33:23 +0200
Subject: [PATCH 16/41] wpaSupp: improve fetching linkByFreq to use list of
 linkInfo sections

Improv:
- fetch link by freq band into splitted linkInfo sections, isof of
doing locally a partial parsing of mlo_status and breaking early
on freqBand match

References: PPM-4222
Signed-off-by: Ahmed Amine HAOUES <ahmed-amine.haoues_ext@softathome.com>
Upstream-Status: Backport [https://gitlab.com/prpl-foundation/prplmesh/pwhm/plugins/pwhm/-/commit/41d46b8c7340255b80c9939ddcb4330096e79021]
---
 src/nl80211/wld_wpaSupp_ep_api.c | 131 +++++++++++++++----------------
 1 file changed, 63 insertions(+), 68 deletions(-)

diff --git a/src/nl80211/wld_wpaSupp_ep_api.c b/src/nl80211/wld_wpaSupp_ep_api.c
index fa46ed0a35dcb3ff7d294ad54bcb175ad804a921..cd9337de0ce40762d0dddb083f8df764466b4b7c 100644
--- a/src/nl80211/wld_wpaSupp_ep_api.c
+++ b/src/nl80211/wld_wpaSupp_ep_api.c
@@ -112,6 +112,35 @@ swl_rc_ne wld_wpaSupp_ep_disconnect(T_EndPoint* pEP) {
     return SWL_RC_OK;
 }
 
+/**
+ * @brief copy link info section from link details list, fetched by frequency band
+ *
+ * @param [in] nbLinks number of links
+ * @param [in] ppLinksDetails array of strings including links details
+ * @param [in] band link freqBand to look for
+ * @param [out] linkStatus target buffer filled with link details
+ * @param [in] linkStatusSize max output buf size
+ *
+ * @return link position (>= 0) in the array, when link section is found
+ *         SWL_RC_NOT_FOUND if no link section has freq param matching the band argument
+ *         negative error code otherwise
+ */
+static int32_t s_getMloLinkStatusDetailsByFreqBand(size_t nbLinks, char** ppLinksDetails, swl_freqBandExt_e band, char* linkStatus, size_t linkStatusSize) {
+    ASSERT_TRUE(linkStatus && linkStatusSize, SWL_RC_INVALID_PARAM, ME, "invalid reply buf");
+    swl_str_copy(linkStatus, linkStatusSize, "");
+    ASSERTS_TRUE(nbLinks > 0, SWL_RC_NOT_FOUND, ME, "no entries");
+    ASSERT_NOT_NULL(ppLinksDetails, SWL_RC_INVALID_PARAM, ME, "NULL");
+    for(size_t i = 0; i < nbLinks; i++) {
+        swl_chanspec_t chspec = SWL_CHANSPEC_EMPTY;
+        if((wld_wpaSupp_fetchChanSpecFromStatusDetails(ppLinksDetails[i], &chspec) >= SWL_RC_OK) &&
+           (chspec.band == band)) {
+            swl_str_copy(linkStatus, linkStatusSize, ppLinksDetails[i]);
+            return i;
+        }
+    }
+    return SWL_RC_NOT_FOUND;
+}
+
 /**
  * @brief parse mlo status information and fetch specific link matching given freq band
  *
@@ -146,18 +175,32 @@ static swl_rc_ne s_parseAllMloStatusDetailsExt(
     swl_str_copy(mloReply, mloReplySize, "");
     char mloLinkStatusBuf[swl_str_len(mloStatusBuf) + 1];
     mloLinkStatusBuf[0] = 0;
-    swl_rc_ne rc = wld_wpaSupp_fetchMloLinkStatusDetailsByFreqBand(mloStatusBuf, linkBand, mloLinkStatusBuf, sizeof(mloLinkStatusBuf));
-    ASSERTS_TRUE(swl_rc_isOk(rc), rc, ME, "fail to fetch mlo link info");
-    swl_macChar_t macStr = SWL_MAC_CHAR_NEW();
-    wld_wpaSupp_fetchChanSpecFromStatusDetails(mloLinkStatusBuf, &pLocConnInfo->chSpec);
-    if((wld_wpaCtrl_getInReplyParamValStr(mloLinkStatusBuf, "sta_link_addr", macStr.cMac, SWL_MAC_CHAR_LEN) >= 0) && swl_mac_charIsValidStaMac(&macStr)) {
-        swl_mac_charToBin(&pLocConnInfo->localMldLinkMac, &macStr);
+
+    size_t nbLinks = 0;
+    char** ppLinksDetails = NULL;
+    swl_rc_ne rc = wld_wpaSupp_fetchMloLinkStatusDetails(mloStatusBuf, &nbLinks, &ppLinksDetails);
+    ASSERTS_TRUE(swl_rc_isOk(rc), rc, ME, "no links info");
+
+    rc = SWL_RC_NOT_FOUND;
+    int32_t pos = s_getMloLinkStatusDetailsByFreqBand(nbLinks, ppLinksDetails, linkBand, mloLinkStatusBuf, sizeof(mloLinkStatusBuf));
+    if(pos >= 0) {
+        rc = SWL_RC_OK;
+        swl_macChar_t macStr = SWL_MAC_CHAR_NEW();
+        wld_wpaSupp_fetchChanSpecFromStatusDetails(mloLinkStatusBuf, &pLocConnInfo->chSpec);
+        if((wld_wpaCtrl_getInReplyParamValStr(mloLinkStatusBuf, "sta_link_addr", macStr.cMac, SWL_MAC_CHAR_LEN) >= 0) && swl_mac_charIsValidStaMac(&macStr)) {
+            swl_mac_charToBin(&pLocConnInfo->localMldLinkMac, &macStr);
+        }
+        if((wld_wpaCtrl_getInReplyParamValStr(mloLinkStatusBuf, "ap_link_addr", macStr.cMac, SWL_MAC_CHAR_LEN) >= 0) && swl_mac_charIsValidStaMac(&macStr)) {
+            swl_mac_charToBin(&pLocConnInfo->peerMldLinkMac, &macStr);
+        }
+        wld_wpaCtrl_getInReplyParamValInt32Def(mloLinkStatusBuf, "link_id", &pLocConnInfo->mldLinkId, -1);
+        swl_str_copy(mloReply, mloReplySize, mloLinkStatusBuf);
     }
-    if((wld_wpaCtrl_getInReplyParamValStr(mloLinkStatusBuf, "ap_link_addr", macStr.cMac, SWL_MAC_CHAR_LEN) >= 0) && swl_mac_charIsValidStaMac(&macStr)) {
-        swl_mac_charToBin(&pLocConnInfo->peerMldLinkMac, &macStr);
+
+    for(size_t i = 0; i < nbLinks; i++) {
+        W_SWL_FREE(ppLinksDetails[i]);
     }
-    wld_wpaCtrl_getInReplyParamValInt32Def(mloLinkStatusBuf, "link_id", &pLocConnInfo->mldLinkId, -1);
-    swl_str_copy(mloReply, mloReplySize, mloLinkStatusBuf);
+    W_SWL_FREE(ppLinksDetails);
     return rc;
 }
 
@@ -754,66 +797,18 @@ swl_rc_ne wld_wpaSupp_fetchMloLinkStatusDetailsByFreqBand(const char* mloStatusI
     swl_str_copy(linkStatus, linkStatusSize, "");
     ASSERTS_STR(mloStatusInfo, SWL_RC_NOT_FOUND, ME, "empty");
 
