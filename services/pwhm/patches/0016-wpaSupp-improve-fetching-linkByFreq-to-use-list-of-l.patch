-            swl_chanspec_t chspec = SWL_CHANSPEC_EMPTY;
-            if((wld_wpaSupp_fetchChanSpecFromStatusDetails(line, &chspec) < SWL_RC_OK) ||
-               (chspec.band != band)) {
-                fillSection = false;
-                section[0] = 0;
-            } else {
-                foundSection = true;
-            }
