+                .activeFreqBands = M_SWL_FREQ_BAND_2_4GHZ | M_SWL_FREQ_BAND_5GHZ,
             }
         },
         {
@@ -479,6 +483,8 @@ static void test_wld_wpaSupp_parseAllStatusDetailsExt(void** state _UNUSED) {
                 .localMldLinkMac = (swl_macBin_t) {{0xac, 0x91, 0x9b, 0xff, 0xf2, 0xd8}},
                 .mldLinkId = 0,
                 .isMainLink = false,
+                .nbMldLinks = 2,
+                .activeFreqBands = M_SWL_FREQ_BAND_2_4GHZ | M_SWL_FREQ_BAND_5GHZ,
             }
         },
         {
@@ -527,6 +533,8 @@ static void test_wld_wpaSupp_parseAllStatusDetailsExt(void** state _UNUSED) {
                 .localMldLinkMac = g_swl_macBin_null,
                 .mldLinkId = -1,
                 .isMainLink = true,
+                .nbMldLinks = 0,
+                .activeFreqBands = M_SWL_FREQ_BAND_5GHZ,
             }
         },
         {
@@ -567,6 +575,8 @@ static void test_wld_wpaSupp_parseAllStatusDetailsExt(void** state _UNUSED) {
                 .localMldLinkMac = g_swl_macBin_null,
                 .mldLinkId = -1,
                 .isMainLink = true,
+                .nbMldLinks = 0,
+                .activeFreqBands = M_SWL_FREQ_BAND_5GHZ,
             }
         },
         {
@@ -622,6 +632,8 @@ static void test_wld_wpaSupp_parseAllStatusDetailsExt(void** state _UNUSED) {
                 .localMldLinkMac = g_swl_macBin_null,
                 .mldLinkId = -1,
                 .isMainLink = true,
+                .nbMldLinks = 0,
+                .activeFreqBands = M_SWL_FREQ_BAND_5GHZ,
             }
         },
         {
@@ -661,6 +673,8 @@ static void test_wld_wpaSupp_parseAllStatusDetailsExt(void** state _UNUSED) {
                 .localMldLinkMac = g_swl_macBin_null,
                 .mldLinkId = -1,
                 .isMainLink = true,
+                .nbMldLinks = 0,
+                .activeFreqBands = M_SWL_FREQ_BAND_5GHZ,
             }
         },
         {
@@ -730,7 +744,9 @@ static void test_wld_wpaSupp_parseAllStatusDetailsExt(void** state _UNUSED) {
                 ttb_assert_int_eq(connInfo.mldLinkId, tests[i].expConnInfo.mldLinkId);
                 ttb_assert_true(swl_typeMacBin_equals(connInfo.peerMldLinkMac, tests[i].expConnInfo.peerMldLinkMac));
                 ttb_assert_true(swl_typeMacBin_equals(connInfo.localMldLinkMac, tests[i].expConnInfo.localMldLinkMac));
+                ttb_assert_int_eq(connInfo.nbMldLinks, tests[i].expConnInfo.nbMldLinks);
             }
+            ttb_assert_int_eq(connInfo.activeFreqBands, tests[i].expConnInfo.activeFreqBands);
         }
