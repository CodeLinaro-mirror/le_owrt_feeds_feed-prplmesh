+#include <stdarg.h>    // needed for cmocka
+#include <sys/types.h> // needed for cmocka
+#include <setjmp.h>    // needed for cmocka
+#include <cmocka.h>
+
+#include "wld.h"
+#include "wld_radio.h"
+#include "wld_endpoint.h"
+#include "wld_ssid.h"
+#include "wld_util.h"
+#include "test-toolbox/ttb_mockClock.h"
+#include "test-toolbox/ttb_assert.h"
+#include "../testHelper/wld_th_mockVendor.h"
+#include "../testHelper/wld_th_radio.h"
+#include "../testHelper/wld_th_vap.h"
+#include "../testHelper/wld_th_dm.h"
+#include "swl/ttb/swl_ttb.h"
+#include "swla/ttb/swla_ttbVariant.h"
+#include <test-toolbox/ttb.h>
+
+#define ME "ep"
+
+static wld_th_dm_t dm;
+static T_EndPoint* epLink0 = NULL;
+
+static void s_doDisableVap(T_AccessPoint* pAP, T_Radio* pRad _UNUSED, wld_th_fsmStates_e state _UNUSED) {
+    assert_non_null(pAP);
+    pAP->enable = 0;
+    wld_vap_updateState(pAP);
+}
+
+static void s_doEnableVap(T_AccessPoint* pAP, T_Radio* pRad _UNUSED, wld_th_fsmStates_e state _UNUSED) {
+    assert_non_null(pAP);
+    pAP->enable = 1;
+    wld_vap_updateState(pAP);
+}
+
+static int s_radStatus(T_Radio* pRad) {
+    if(pRad) {
+        if(pRad->enable && (wld_rad_hasEnabledVap(pRad) || wld_rad_hasEnabledEp(pRad))) {
+            pRad->detailedState = CM_RAD_UP;
+            return true;
+        }
+        if(pRad->index <= 0) {
+            pRad->detailedState = CM_RAD_ERROR;
+        } else {
+            pRad->detailedState = CM_RAD_DOWN;
+        }
+    }
+    return false;
+}
+
+static swl_rc_ne s_stopFronthaul(T_Radio* pRad) {
+    assert_non_null(pRad);
+    swl_rc_ne rc = SWL_RC_INVALID_STATE;
+    T_AccessPoint* pAP = NULL;
+    wld_rad_forEachAp(pAP, pRad) {
+        if(wld_ap_hasStackEnabled(pAP)) {
+            pAP->pFA->mfn_wvap_enable(pAP, false, SET);
+            rc = SWL_RC_OK;
+        }
+    }
+    return rc;
+}
+
+static swl_rc_ne s_restoreFronthaul(T_Radio* pRad) {
+    assert_non_null(pRad);
+    swl_rc_ne rc = SWL_RC_INVALID_STATE;
+    T_AccessPoint* pAP = NULL;
+    wld_rad_forEachAp(pAP, pRad) {
+        if(!wld_ap_hasStackEnabled(pAP)) {
+            pAP->pFA->mfn_wvap_enable(pAP, true, SET);
+            rc = SWL_RC_OK;
+        }
+    }
+    return rc;
+}
+
+static int s_setupSuite(void** state _UNUSED) {
+    whm_th_fsm_useMgr(true);
+    assert_true(wld_th_dm_init(&dm));
+    ttb_object_t* obj = dm.ttbBus->rootObj;
+    swl_typeUInt32_commitObjectParam(ttb_object_getChildObject(obj, "AutoCommitMgr"), "DelayTime", 1000);
+    swl_typeCharPtr_commitObjectParam(ttb_object_getChildObject(obj, "Config"), "EnableSyncMode", "Off");
+    T_Radio* pRad = NULL;
+    wld_for_eachRad(pRad) {
+        pRad->vendor->fta.mfn_wrad_radio_status = s_radStatus;
+        pRad->vendor->fta.mfn_wrad_stopFronthaul = s_stopFronthaul;
+        pRad->vendor->fta.mfn_wrad_restoreFronthaul = s_restoreFronthaul;
+        T_AccessPoint* pAP = NULL;
+        wld_rad_forEachAp(pAP, pRad) {
+            wld_th_vap_vendorData_t* vd = wld_th_vap_getVendorData(pAP);
+            vd->fsmCallback[WLD_TH_FSM_SET_VAP_ENABLE_DOWN] = s_doDisableVap;
+            vd->fsmCallback[WLD_TH_FSM_SET_VAP_ENABLE] = s_doEnableVap;
+        }
+    }
+
+    epLink0 = wld_getEndpointByAlias("sta0");
+    assert_non_null(epLink0);
+
+    return 0;
+}
+
+static int s_teardownSuite(void** state _UNUSED) {
+    wld_th_dm_destroy(&dm);
+    return 0;
+}
+
+typedef struct {
+    T_EndPoint* pEP;
+    wld_epConnectionStatus_e connSt;
+    wld_epError_e connErr;
+    uint32_t nChecks;
+    struct {
+        uint32_t retDelayMs; /** time to wait before checking fronthaul status */
+        bool expFhSt;        /** expected fronthaul status */
+    } checks[2];
+} testBhFhEna;
+
+#define SHORT_WAIT 100
+#define LONG_WAIT 2000
+static void test_ep_toggleBssOnReconnect(void** state _UNUSED) {
+    wld_th_dm_clearFsm(&dm);
+    swl_typeBool_commitObjectParam(epLink0->pBus, "ToggleBssOnReconnect", true);
+    swl_typeUInt32_commitObjectParam(epLink0->pBus, "RestoreBssDelay", 1000);
+    ttb_mockTimer_goToFutureMs(SHORT_WAIT);
+
+    testBhFhEna tests[] = {
+        /** endpoint idle => fronthaul shall remain active */
+        {epLink0, EPCS_IDLE, EPE_NONE, 1, {{SHORT_WAIT, true, }}},
+        /** endpoint pairing => fronthaul shall be stopped */
+        {epLink0, EPCS_WPS_PAIRING, EPE_NONE, 1, {{LONG_WAIT, false, }}},
+        /** endpoint pairing timeouted => fronthaul shall be restored after restoreBssDelay */
+        {epLink0, EPCS_WPS_TIMEOUT, EPE_NONE, 2, {{SHORT_WAIT, false, }, {LONG_WAIT, true, }}},
+        /** endpoint pairing => fronthaul shall be stopped */
+        {epLink0, EPCS_WPS_PAIRING, EPE_NONE, 1, {{LONG_WAIT, false, }}},
+        /** endpoint pairing done => fronthaul shall remain stopped, as connection will follow*/
+        {epLink0, EPCS_WPS_PAIRINGDONE, EPE_NONE, 2, {{SHORT_WAIT, false, }, {LONG_WAIT, false, }}},
+        /** endpoint scanning => fronthaul shall remain stopped */
+        {epLink0, EPCS_DISCOVERING, EPE_NONE, 1, {{SHORT_WAIT, false, }}},
+        /** endpoint connecting => fronthaul shall remain stopped */
+        {epLink0, EPCS_CONNECTING, EPE_NONE, 1, {{SHORT_WAIT, false, }}},
+        /** endpoint connected => fronthaul shall be restored after restoreBssDelay */
+        {epLink0, EPCS_CONNECTED, EPE_NONE, 2, {{SHORT_WAIT, false, }, {LONG_WAIT, true, }}},
+        /** endpoint disconnected => fronthaul shall remain active */
+        {epLink0, EPCS_DISCONNECTED, EPE_NONE, 2, {{SHORT_WAIT, true, }, {LONG_WAIT, true, }}},
+        /** endpoint scanning => fronthaul shall be stopped */
+        {epLink0, EPCS_DISCOVERING, EPE_NONE, 1, {{LONG_WAIT, false, }}},
+        /** endpoint failed to find remote AP => fronthaul shall be restored after restoreBssDelay */
+        {epLink0, EPCS_ERROR, EPE_SSID_NOT_FOUND, 2, {{SHORT_WAIT, false, }, {LONG_WAIT, true, }}},
+        /** endpoint connecting again (scan evt missed) => fronthaul shall be stopped */
+        {epLink0, EPCS_CONNECTING, EPE_NONE, 1, {{LONG_WAIT, false, }}},
+        /** endpoint failed to connect => fronthaul shall be restored after restoreBssDelay */
+        {epLink0, EPCS_ERROR, EPE_INVALID_PASSPHRASE, 2, {{SHORT_WAIT, false, }, {LONG_WAIT, true, }}},
+    };
+    for(uint32_t i = 0; i < SWL_ARRAY_SIZE(tests); i++) {
+        testBhFhEna* pTest = &tests[i];
+        wld_endpoint_setConnectionStatus(pTest->pEP, pTest->connSt, pTest->connErr);
+        for(uint32_t j = 0; j < pTest->nChecks; j++) {
+            uint32_t retDelayMs = pTest->checks[j].retDelayMs;
+            bool expFhSt = pTest->checks[j].expFhSt;
+            ttb_assert_addPrint("[%u] Mismatch FH status(exp:%d) after setting EP(%s) to connSt(%i)ConnErr(%i) with delay(%u)",
+                                i, expFhSt, pTest->pEP->alias, pTest->connSt, pTest->connErr, retDelayMs);
+            if(retDelayMs > 0) {
+                ttb_mockTimer_goToFutureMs(retDelayMs);
+            }
+            ttb_assert_int_eq(wld_rad_hasActiveVap(pTest->pEP->pRadio), expFhSt);
+            ttb_assert_removeLastPrint();
+        }
+    }
+}
+
+int main(int argc _UNUSED, char* argv[] _UNUSED) {
+    sahTraceOpen("testApp", TRACE_TYPE_STDERR);
+    sahTraceSetLevel(TRACE_LEVEL_INFO);
+    sahTraceAddZone(sahTraceLevel(), "ep");
+    sahTraceAddZone(sahTraceLevel(), "epFh");
+    sahTraceAddZone(sahTraceLevel(), "ap");
+    sahTraceAddZone(sahTraceLevel(), "rad");
+    const struct CMUnitTest tests[] = {
+        cmocka_unit_test(test_ep_toggleBssOnReconnect),
+    };
+
+    int rc = cmocka_run_group_tests(tests, s_setupSuite, s_teardownSuite);
+    sahTraceClose();
+    return rc;
+}
