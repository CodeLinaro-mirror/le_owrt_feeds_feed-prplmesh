From 70b30ea1ef8530ca0b8f566c9079ad0af5d499c1 Mon Sep 17 00:00:00 2001
From: Ahmed Amine HAOUES <ahmed-amine.haoues_ext@softathome.com>
Date: Tue, 19 May 2026 11:31:37 +0200
Subject: [PATCH 15/41] test: add unit test to check splitting mlo_status reply
 into separate links details

New test:
- add new test to check proper splitting of valid mlo_status reply into
separate linkInfo string sections

References: PPM-4222
Signed-off-by: Ahmed Amine HAOUES <ahmed-amine.haoues_ext@softathome.com>
Upstream-Status: Backport [https://gitlab.com/prpl-foundation/prplmesh/pwhm/plugins/pwhm/-/commit/ab39fb8aac69a99defd4656eaca572d4cde442e9]
---
 test/wld_wpaSupp/test_wld_wpaSupp.c | 85 +++++++++++++++++++++++++++++
 1 file changed, 85 insertions(+)

diff --git a/test/wld_wpaSupp/test_wld_wpaSupp.c b/test/wld_wpaSupp/test_wld_wpaSupp.c
index cdff78798bb0288c13f9c089ffdcbe996a71ec0d..83d20ca49d7a1a967fa5b58c5ef383ad36d08bb7 100644
--- a/test/wld_wpaSupp/test_wld_wpaSupp.c
+++ b/test/wld_wpaSupp/test_wld_wpaSupp.c
@@ -122,6 +122,90 @@ static void test_wld_wpaSupp_fetchChanSpecFromStatusDetails(void** state _UNUSED
     }
 }
 
+static void test_wld_wpaSupp_fetchMloLinkStatusDetails(void** state _UNUSED) {
+#define MAX_LINKS 4
+    struct {
+        const char* inMsg;
+        swl_rc_ne expRc;
+        size_t expNbLinks;
+        const char* expOutMsg[MAX_LINKS];
+    } tests[] = {
+        // 3 links
+        {
+            "link_id=0\nfreq=2412\nap_link_addr=ae:91:9b:ff:f6:58\nsta_link_addr=ac:91:9b:ff:f2:d9\n"
+            "link_id=1\nfreq=5180\nap_link_addr=ae:91:9b:ff:f5:59\nsta_link_addr=ac:91:9b:ff:f2:da\n"
+            "link_id=2\nfreq=6135\nap_link_addr=ae:91:9b:ff:f4:5a\nsta_link_addr=ac:91:9b:ff:f2:db",
+            SWL_RC_OK,
+            3,
+            {
+                "link_id=0\nfreq=2412\nap_link_addr=ae:91:9b:ff:f6:58\nsta_link_addr=ac:91:9b:ff:f2:d9",
+                "link_id=1\nfreq=5180\nap_link_addr=ae:91:9b:ff:f5:59\nsta_link_addr=ac:91:9b:ff:f2:da",
+                "link_id=2\nfreq=6135\nap_link_addr=ae:91:9b:ff:f4:5a\nsta_link_addr=ac:91:9b:ff:f2:db",
+            },
+        },
+        // 2 links
+        {
+            "link_id=0\nfreq=5180\nap_link_addr=ae:91:9b:ff:f5:59\nsta_link_addr=ac:91:9b:ff:f2:d8\n"
+            "link_id=2\nfreq=2412\nap_link_addr=ae:91:9b:ff:f6:58\nsta_link_addr=ac:91:9b:ff:f2:da",
+            SWL_RC_OK,
+            2,
+            {
+                "link_id=0\nfreq=5180\nap_link_addr=ae:91:9b:ff:f5:59\nsta_link_addr=ac:91:9b:ff:f2:d8",
+                "link_id=2\nfreq=2412\nap_link_addr=ae:91:9b:ff:f6:58\nsta_link_addr=ac:91:9b:ff:f2:da",
+            },
+        },
+        // 1 link
+        {
+            "link_id=0\nfreq=5180\nap_link_addr=ae:91:9b:ff:f5:59\nsta_link_addr=ac:91:9b:ff:f2:d8\n",
+            SWL_RC_OK,
+            1,
+            {
+                "link_id=0\nfreq=5180\nap_link_addr=ae:91:9b:ff:f5:59\nsta_link_addr=ac:91:9b:ff:f2:d8",
+            },
+        },
+        // skipping empty lines on top
+        {
+            "\n\n\nlink_id=2\nfreq=2412\nap_link_addr=ae:91:9b:ff:f6:58\nsta_link_addr=ac:91:9b:ff:f2:da",
+            SWL_RC_OK,
+            1,
+            {
+                "link_id=2\nfreq=2412\nap_link_addr=ae:91:9b:ff:f6:58\nsta_link_addr=ac:91:9b:ff:f2:da",
+            },
+        },
+        // invalid mlo links details
+        {
+            "bssid=ac:91:9b:ff:f3:58\nfreq=6135\nssid=prpl3\nid=1\nmode=station\nwifi_generation=7",
+            SWL_RC_NOT_FOUND,
+            0,
+            {}
+        },
+        // no content
+        {
+            "",
+            SWL_RC_NOT_FOUND,
+            0,
+            {}
+        },
+    };
+    swl_rc_ne rc;
+    for(size_t i = 0; i < SWL_ARRAY_SIZE(tests); i++) {
+        size_t nbLinks = 0;
+        char** ppLinksInfo = NULL;
+        rc = wld_wpaSupp_fetchMloLinkStatusDetails(tests[i].inMsg, &nbLinks, &ppLinksInfo);
+        ttb_assert_int_eq(rc, tests[i].expRc);
+        if(swl_rc_isOk(rc)) {
+            uint32_t nMatchLinksInfo = 0;
+            for(size_t j = 0; j < nbLinks && ppLinksInfo; j++) {
+                nMatchLinksInfo += swl_str_matches(ppLinksInfo[j], tests[i].expOutMsg[j]);
+                W_SWL_FREE(ppLinksInfo[j]);
+            }
+            W_SWL_FREE(ppLinksInfo);
+            ttb_assert_int_eq(tests[i].expNbLinks, nbLinks);
+            ttb_assert_int_eq(nMatchLinksInfo, nbLinks);
+        }
+    }
+}
+
 static void test_wld_wpaSupp_fetchMloLinkStatusDetailsByFreqBand(void** state _UNUSED) {
     struct {
         const char* inMsg;
@@ -672,6 +756,7 @@ int main(int argc _UNUSED, char* argv[] _UNUSED) {
     sahTraceAddZone(sahTraceLevel(), "wpaCtrl");
     const struct CMUnitTest tests[] = {
         cmocka_unit_test(test_wld_wpaSupp_fetchChanSpecFromStatusDetails),
+        cmocka_unit_test(test_wld_wpaSupp_fetchMloLinkStatusDetails),
         cmocka_unit_test(test_wld_wpaSupp_fetchMloLinkStatusDetailsByFreqBand),
         cmocka_unit_test(test_wld_wpaSupp_parseAllStatusDetailsExt),
     };
